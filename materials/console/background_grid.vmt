UnlitGeneric
{
	$basetexture "console/background_grid"

	$basetexturetransform "center 0.5 0.5 scale 0.4 0.9 rotate -15 translate 0 0"

	$vertexcolor 1
	$vertexalpha 1
	$ignorez 1
	$nolod 1
	$no_fullbright 1

	%keywords "tf"

	Proxies
	{
		TextureScroll
		{
			texturescrollvar "$basetexturetransform"
			texturescrollrate .01
			texturescrollangle 45
		}
	}
}